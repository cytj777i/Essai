-- ==================== 功能函数（核心修复区域） ====================

-- 检查玩家是否被选中
local function isPlayerSelected(player)
    for _, p in ipairs(State.selectedPlayers) do
        if p == player then return true end
    end
    return false
end

-- 从选中列表移除玩家
local function removeSelectedPlayer(player)
    for i, p in ipairs(State.selectedPlayers) do
        if p == player then
            table.remove(State.selectedPlayers, i)
            return
        end
    end
end

-- 【核心修复】改回 SetAttribute 存储原始透明度，绑定在实例上永不丢失
local function applyPartTransparency(part, transparent)
    if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
        if transparent then
            -- 只记录一次，避免重复覆盖
            if part:GetAttribute("OriginalTransparency") == nil then
                part:SetAttribute("OriginalTransparency", part.Transparency)
            end
            part.Transparency = 1
        else
            local original = part:GetAttribute("OriginalTransparency")
            if original ~= nil then
                part.Transparency = original
                part:SetAttribute("OriginalTransparency", nil)
            else
                -- 【修复中心方块】没有记录时的安全默认值
                if part:IsA("BasePart") and part.Name == "HumanoidRootPart" then
                    part.Transparency = 1
                elseif part.Transparency == 1 then
                    part.Transparency = 0
                end
                -- 如果当前不是1（自定义半透部件），保持原样不动
            end
        end
    elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Beam") then
        part.Enabled = not transparent
    end
end

-- 应用透明度到整个角色
local function setPlayerTransparency(player, transparent)
    if not player or not player.Character then return end
    
    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    for _, part in ipairs(character:GetDescendants()) do
        applyPartTransparency(part, transparent)
    end
    
    if humanoid then
        humanoid.DisplayDistanceType = transparent 
            and Enum.HumanoidDisplayDistanceType.None 
            or Enum.HumanoidDisplayDistanceType.Viewer
    end
    
    local head = character:FindFirstChild("Head")
    if head then
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("BillboardGui") and child.Name ~= "SelectionBox" then
                child.Enabled = not transparent
            end
        end
    end
end

-- 启动透明控制：事件驱动 + 循环后备
local function startTransparency(player)
    if not player then return end
    
    -- 清理旧连接（避免重复）
    if State.activeConnections[player] then
        for _, conn in ipairs(State.activeConnections[player]) do
            if typeof(conn) == "RBXScriptConnection" then
                conn:Disconnect()
            end
        end
        State.activeConnections[player] = nil
    end
    
    -- 立即应用透明（无延迟）
    setPlayerTransparency(player, true)
    
    local connections = {}
    
    -- 角色重生时自动应用
    local charConn = player.CharacterAdded:Connect(function(char)
        RunService.Heartbeat:Wait()
        if State.transparencyEnabled and isPlayerSelected(player) then
            setPlayerTransparency(player, true)
            
            -- 监听新部件（如Accessory、工具等动态添加）
            local descConn = char.DescendantAdded:Connect(function(descendant)
                if State.transparencyEnabled and isPlayerSelected(player) then
                    applyPartTransparency(descendant, true)
                end
            end)
            table.insert(connections, descConn)
        end
    end)
    table.insert(connections, charConn)
    
    -- 对当前已存在的角色，监听动态添加的部件
    if player.Character then
        local descConn = player.Character.DescendantAdded:Connect(function(descendant)
            if State.transparencyEnabled and isPlayerSelected(player) then
                applyPartTransparency(descendant, true)
            end
        end)
        table.insert(connections, descConn)
    end
    
    -- 【关键】循环后备：每0.2秒强制刷新，防止其他脚本/网络重置透明度
    local lastUpdate = 0
    local heartbeatConn = RunService.Heartbeat:Connect(function(dt)
        lastUpdate = lastUpdate + dt
        if lastUpdate < 0.2 then return end
        lastUpdate = 0
        
        if not (State.transparencyEnabled and isPlayerSelected(player) and player.Parent) then
            heartbeatConn:Disconnect()
            return
        end
        setPlayerTransparency(player, true)
    end)
    table.insert(connections, heartbeatConn)
    
    State.activeConnections[player] = connections
end

-- 停止透明控制
local function stopTransparency(player)
    if not player then return end
    
    if State.activeConnections[player] then
        for _, conn in ipairs(State.activeConnections[player]) do
            if typeof(conn) == "RBXScriptConnection" then
                conn:Disconnect()
            end
        end
        State.activeConnections[player] = nil
    end
    
    -- 立即恢复，无延迟
    setPlayerTransparency(player, false)
end

-- 更新开关视觉
local function updateToggleVisual()
    if State.transparencyEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        ToggleButton.Text = "ON"
        ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        ToggleButton.Text = "OFF"
        ToggleButton.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end

-- 更新选中标签显示
local function updateSelectedLabel()
    if #State.selectedPlayers == 0 then
        SelectedLabel.Text = "  未选择玩家"
        SelectedLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
    else
        local names = {}
        for _, p in ipairs(State.selectedPlayers) do
            table.insert(names, p.DisplayName)
        end
        local text = "  已选 " .. #State.selectedPlayers .. " 人: " .. table.concat(names, ", ")
        if #text > 35 then
            text = string.sub(text, 1, 32) .. "..."
        end
        SelectedLabel.Text = text
        SelectedLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end

-- 刷新玩家列表
local function refreshPlayerList()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local selected = isPlayerSelected(player)
        
        local btn = Instance.new("TextButton")
        btn.Name = player.Name
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.BackgroundColor3 = selected 
            and Color3.fromRGB(55, 55, 55) 
            or Color3.fromRGB(30, 30, 30)
        btn.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        btn.TextColor3 = selected
            and Color3.fromRGB(255, 255, 255)
            or Color3.fromRGB(170, 170, 170)
        btn.TextSize = 12
        btn.Font = Enum.Font.Gotham
        btn.ZIndex = 4
        btn.Parent = ScrollingFrame
        
        -- 选中指示器（左侧竖线）
        if selected then
            local indicator = Instance.new("Frame")
            indicator.Name = "Indicator"
            indicator.Size = UDim2.new(0, 3, 1, -6)
            indicator.Position = UDim2.new(0, 0, 0, 3)
            indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            indicator.BorderSizePixel = 0
            indicator.ZIndex = 5
            indicator.Parent = btn
        end
        
        -- 点击切换选择
        btn.MouseButton1Click:Connect(function()
            if selected then
                removeSelectedPlayer(player)
                stopTransparency(player)
            else
                table.insert(State.selectedPlayers, player)
                if State.transparencyEnabled then
                    startTransparency(player)
                end
            end
            
            refreshPlayerList()
            updateSelectedLabel()
        end)
    end
end

-- ==================== 拖动功能 ====================
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        State.isDragging = true
        State.dragStart = input.Position
        State.uiStartPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if State.isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
       input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - State.dragStart
        MainFrame.Position = UDim2.new(
            State.uiStartPos.X.Scale, 
            State.uiStartPos.X.Offset + delta.X,
            State.uiStartPos.Y.Scale, 
            State.uiStartPos.Y.Offset + delta.Y
        )
    elseif State.isResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or 
           input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - State.resizeStart
        
        -- 【核心修改】等比例缩放：基于原始尺寸和鼠标移动计算统一缩放比例
        local scaleX = (ORIGINAL_SIZE.X * State.startScale + delta.X) / ORIGINAL_SIZE.X
        local scaleY = (ORIGINAL_SIZE.Y * State.startScale + delta.Y) / ORIGINAL_SIZE.Y
        local newScale = math.clamp((scaleX + scaleY) / 2, 0.5, 2.0)
        
        UIScale.Scale = newScale
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        State.isDragging = false
        State.isResizing = false
    end
end)

-- ==================== 缩放功能 ====================
ResizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        State.isResizing = true
        State.resizeStart = input.Position
        State.startScale = UIScale.Scale
    end
end)

