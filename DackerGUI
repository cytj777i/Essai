            local scriptCode = string.format([[
                -- 停止所有现有音乐
                for _, sound in pairs(game.Workspace:GetChildren()) do
                    if sound:IsA("Sound") then
                        sound:Stop()
                        sound:Destroy()
                    end
                end
                
                -- 播放新音乐
                local sound = Instance.new("Sound")
                sound.SoundId = "rbxassetid://%s"
                sound.PlaybackSpeed = %s
                sound.Volume = 10
                sound.Looped = true
                sound.Parent = game.Workspace
                sound:Play()
                
                -- 确保音乐循环播放
                sound.Ended:Connect(function()
                    sound:Play()
                end)
            ]], musicData.soundId, tostring(musicData.playbackSpeed))
            
            autoDetectAndExecute(scriptCode, "✅ 正在播放：" .. musicData.name)
        end)
        buttonY = buttonY + 50
    end
    
