    ClearButton.MouseButton1Click:Connect(function()
        local scriptCode = [[
            -- 清除天空盒
            if game:GetService("Lighting"):FindFirstChild("Sky") then
                game:GetService("Lighting").Sky:Destroy()
            end

            -- 清除声音
            for _, sound in pairs(game.Workspace:GetChildren()) do
                if sound:IsA("Sound") then
                    sound:Stop()
                    sound:Destroy()
                end
            end

            -- 清除粒子效果
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("ParticleEmitter") then
                    obj:Destroy()
                end
            end

            -- 清除BillboardGui
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BillboardGui") then
                    obj:Destroy()
                end
            end

            -- 清除选择框
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("SelectionBox") then
                    obj:Destroy()
                end
            end

            -- 清除点光源
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("PointLight") then
                    obj:Destroy()
                end
            end

            -- 清除火焰效果
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Fire") then
                    obj:Destroy()
                end
            end

            -- 清除屏幕GUI
            for _, targetPlayer in pairs(game:GetService("Players"):GetPlayers()) do
                if targetPlayer:FindFirstChild("PlayerGui") then
                    for _, gui in pairs(targetPlayer.PlayerGui:GetChildren()) do
                        if gui.Name == "JumpScare" then
                            gui:Destroy()
                        end
                    end
                end
