-- ==================== Animation System ====================
-- Continuous cube rotation
local cubeRotateTween = TweenService:Create(
    hologramContainer,
    TweenInfo.new(ANIMATION.CubeRotateTime, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1, false),
    {Rotation = 360}
)
cubeRotateTween:Play()

-- Progress bar fill animation from 0% to 100%
local progressTween = TweenService:Create(
    progressBarFill,
    TweenInfo.new(ANIMATION.LoadSimulationTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
    {Size = UDim2.fromScale(1, 1)}
)
progressTween:Play()

-- Main loop for all animations
local mainConnection = RunService.Heartbeat:Connect(function(deltaTime)
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local currentTime = os.clock()

    -- Particle movement animation
    for _, particleData in ipairs(particles) do
        local particle, vx, vy = unpack(particleData)
        local currentX = particle.Position.X.Offset
        local currentY = particle.Position.Y.Offset
        local newX = currentX + vx * deltaTime
        local newY = currentY + vy * deltaTime

        if newX < 0 or newX > viewportSize.X then
            vx = -vx
            newX = math.clamp(newX, 0, viewportSize.X)
        end
        if newY < 0 or newY > viewportSize.Y then
            vy = -vy
            newY = math.clamp(newY, 0, viewportSize.Y)
        end

        particle.Position = UDim2.fromOffset(newX, newY)
        particleData[2], particleData[3] = vx, vy
    end

    -- Light streak scrolling animation
    for _, streakData in ipairs(streaks) do
        local streak, speed, direction = unpack(streakData)
        local currentX = streak.Position.X.Offset
        local newX = currentX + speed * direction * deltaTime
        
        if (direction == 1 and newX > viewportSize.X + streak.AbsoluteSize.X/2) or
           (direction == -1 and newX < -streak.AbsoluteSize.X/2) then
            newX = direction == 1 and -streak.AbsoluteSize.X/2 or viewportSize.X + streak.AbsoluteSize.X/2
            streak.Position = UDim2.fromOffset(newX, math.random(0, viewportSize.Y))
            streak.Rotation = math.random(-40, 40)
        else
            streak.Position = UDim2.fromOffset(newX, streak.Position.Y.Offset)
        end
    end

    -- Cube edge glow movement
    for _, flowData in ipairs(edgeFlows) do
        local flow = flowData.flow
        local offset = flowData.offset
        local isVertical = flowData.isVertical

        local progress = ((currentTime + offset) % ANIMATION.EdgeFlowTime) / ANIMATION.EdgeFlowTime
        
        if isVertical then
            flow.Position = UDim2.fromScale(0.5, progress)
        else
            flow.Position = UDim2.fromScale(progress, 0.5)
        end
    end

    -- Progress bar glow flow animation
    local progressFlowProgress = (currentTime % ANIMATION.ProgressFlowTime) / ANIMATION.ProgressFlowTime
    progressFlow.Position = UDim2.fromScale(progressFlowProgress - 0.2, 0)
end)

-- ==================== Loading Complete Logic ====================
local function onLoadingComplete()
    -- Stop dots animation to prevent memory leak
    dotsAnimationRunning = false
    
    -- Disconnect all animation connections
    mainConnection:Disconnect()
    cubeRotateTween:Cancel()
    progressTween:Cancel()
    
    local fadeTweenInfo = TweenInfo.new(ANIMATION.FadeOutTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    -- Fade out background
    TweenService:Create(background, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    
    -- Fade out all particles
    for _, particleData in ipairs(particles) do
        local particle = particleData[1]
        TweenService:Create(particle, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    end
    
    -- Fade out all light streaks
    for _, streakData in ipairs(streaks) do
        local streak = streakData[1]
        TweenService:Create(streak, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    end
    
    -- Fade out cube edges and glow effects
    for _, edge in ipairs(cubeEdges) do
        TweenService:Create(edge, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    end
    for _, flowData in ipairs(edgeFlows) do
        TweenService:Create(flowData.flow, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    end
    
    -- Fade out progress bar and text
    TweenService:Create(loadingInfoContainer, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(loadingText, fadeTweenInfo, {TextTransparency = 1}):Play()
    TweenService:Create(progressBarBg, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(progressBarFill, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(progressFlow, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
    
    -- Destroy UI after fade animation ends
    task.wait(ANIMATION.FadeOutTime)
    loadingGui:Destroy()
end

