-- ==================== Fullscreen Particle Effect System ====================
local particlesContainer = Instance.new("Frame")
particlesContainer.Name = "ParticlesContainer"
particlesContainer.Size = UDim2.fromScale(1, 1)
particlesContainer.BackgroundTransparency = 1
particlesContainer.ClipsDescendants = true
particlesContainer.Parent = loadingGui

local particles = {}
local function createParticle()
    local particle = Instance.new("Frame")
    particle.Name = "Particle"
    particle.Size = UDim2.fromOffset(math.random(2, 5), math.random(2, 5))
    particle.BackgroundColor3 = math.random() > 0.5 and COLORS.ParticleWhite or COLORS.ParticleBlue
    particle.BackgroundTransparency = math.random(0.5, 0.85)
    particle.BorderSizePixel = 0
    particle.Parent = particlesContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = particle

    local viewportSize = workspace.CurrentCamera.ViewportSize
    local startX = math.random(0, viewportSize.X)
    local startY = math.random(0, viewportSize.Y)
    local speed = math.random(ANIMATION.ParticleSpeed * 0.5, ANIMATION.ParticleSpeed * 1.5)
    local angle = math.random() * math.pi * 2
    local velocityX = math.cos(angle) * speed
    local velocityY = math.sin(angle) * speed

    particle.Position = UDim2.fromOffset(startX, startY)

    return particle, velocityX, velocityY
end

for _ = 1, ANIMATION.ParticleCount do
    table.insert(particles, {createParticle()})
end

-- ==================== Multi-Layer Light Streak System ====================
local lightStreaksContainer = Instance.new("Frame")
lightStreaksContainer.Name = "LightStreaksContainer"
lightStreaksContainer.Size = UDim2.fromScale(1, 1)
lightStreaksContainer.BackgroundTransparency = 1
lightStreaksContainer.ClipsDescendants = true
lightStreaksContainer.Parent = loadingGui

local function createLightStreak(layer)
    local streak = Instance.new("Frame")
    streak.Name = "LightStreak_Layer"..layer
    streak.Size = UDim2.fromOffset(math.random(200, 500), layer == 1 and 1.5 or 2.5)
    streak.BackgroundColor3 = layer == 1 and COLORS.SecondaryGlow or COLORS.PrimaryGlow
    streak.BorderSizePixel = 0
    streak.AnchorPoint = Vector2.new(0.5, 0.5)
    streak.Rotation = math.random(-40, 40)
    streak.BackgroundTransparency = layer == 1 and 0.7 or 0.4
    streak.Parent = lightStreaksContainer

    local streakGradient = Instance.new("UIGradient")
    streakGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.25, 0.5),
        NumberSequenceKeypoint.new(0.75, 0.5),
        NumberSequenceKeypoint.new(1, 1)
    })
    streakGradient.Parent = streak

    local speed = layer == 1 and math.random(40, 90) or math.random(100, 200)
    local direction = math.random() > 0.5 and 1 or -1
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local startX = direction == 1 and -streak.AbsoluteSize.X/2 or viewportSize.X + streak.AbsoluteSize.X/2
    local startY = math.random(0, viewportSize.Y)
    
    streak.Position = UDim2.fromOffset(startX, startY)
    
    return streak, speed, direction
end

local streaks = {}
for layer = 1, 2 do
    for _ = 1, 6 do
        table.insert(streaks, {createLightStreak(layer)})
    end
end

