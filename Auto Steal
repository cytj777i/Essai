-- 循环设置/清除保护属性
task.spawn(function()
    while true do
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            if States.AntiNPCCatch then
                char:SetAttribute("TeleportImmune", true)
            else
                if char:GetAttribute("TeleportImmune") ~= nil then
                    char:SetAttribute("TeleportImmune", nil)
                end
            end
            
            if States.FreezeGuards then
                char:SetAttribute("GuardsFrozen", true)
            else
                if char:GetAttribute("GuardsFrozen") ~= nil then
                    char:SetAttribute("GuardsFrozen", nil)
                end
            end
        end)
        task.wait(0.5)
    end
end)

-- 安全区坐标
local SAFE_TELEPORT_POS = Vector3.new(-5.6, 3.0, 24.4)

-- 分步传送：先脱离危险区，再进入安全区
local function doSafeTeleport()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 60, 0))
    task.wait(0.25)
    hrp.CFrame = CFrame.new(SAFE_TELEPORT_POS + Vector3.new(0, 30, 0))
    task.wait(0.2)
    hrp.CFrame = CFrame.new(SAFE_TELEPORT_POS + Vector3.new(0, 5, 0))
    task.wait(0.15)
    hrp.CFrame = CFrame.new(SAFE_TELEPORT_POS)
end

-- 偷取后自动传送
local function setupStealTeleport()
    local char = LocalPlayer.Character
    if not char then return end
    
    char:GetAttributeChangedSignal("Carrying"):Connect(function()
        if not States.AutoTeleportOnSteal then return end
        if char:GetAttribute("Carrying") == true then
            task.spawn(doSafeTeleport)
        end
    end)
end

if LocalPlayer.Character then
    setupStealTeleport()
end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    setupStealTeleport()
    
    pcall(function()
        if States.AntiNPCCatch then
            char:SetAttribute("TeleportImmune", true)
        end
        if States.FreezeGuards then
            char:SetAttribute("GuardsFrozen", true)
        end
    end)
end)

