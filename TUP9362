    if backdoor.ClassName == "RemoteEvent" then
        backdoor:FireServer(jumpScareScript)
    elseif backdoor.ClassName == "RemoteFunction" then
        backdoor:InvokeServer(jumpScareScript)
    end
    
    notify(string.format("✅ 跳脸已执行 (图片ID: %s)", imageId))
end

