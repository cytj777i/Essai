-- ========== 核心逻辑 ==========
local running = false
local expanded = true
local dragging = false
local dragStart, dragPos = nil, nil
local curScale = 1.0
local feedConn = nil
local lastTarget = nil

local SCALE_PRESETS = {0.7, 0.85, 1.0, 1.15, 1.3}
local scaleIndex = 3

local function tween(obj, props, dur)
	TweenService:Create(obj, TweenInfo.new(dur or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function setSwitch(on)
	local c = on and Color3.fromRGB(255, 60, 120) or Color3.fromRGB(35, 15, 25)
	local p = on and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
	tween(Track, {BackgroundColor3 = c}, 0.2)
	tween(Thumb, {Position = p}, 0.2)
end

local function setStatus(txt, col, dcol)
	StatusTxt.Text = txt
	if col then StatusTxt.TextColor3 = col end
	if dcol then StatusDot.BackgroundColor3 = dcol end
end

local function doFeed()
	if not running then return end
	local t = lastTarget or getTarget()
	lastTarget = t
	local cd = getCD(t)
	if not t or not cd then
		setStatus("未找到Teto", Color3.fromRGB(255, 120, 120), Color3.fromRGB(255, 80, 80))
		return
	end
	local tp = getPos(t)
	local pp = getPPos()
	if not tp or not pp then
		setStatus("位置丢失", Color3.fromRGB(255, 160, 140), Color3.fromRGB(255, 120, 100))
		return
	end
	local dist = (tp - pp).Magnitude
	DistTxt.Text = string.format("%.1f 格", dist)
	if dist <= MAX_DIST then
		DistTxt.TextColor3 = Color3.fromRGB(255, 160, 200)
		setStatus("正在投喂", Color3.fromRGB(255, 220, 240), Color3.fromRGB(255, 80, 130))
		pcall(function()
			fireclickdetector(cd)
		end)
	else
		DistTxt.TextColor3 = Color3.fromRGB(255, 120, 120)
		setStatus("距离过远", Color3.fromRGB(255, 180, 160), Color3.fromRGB(255, 140, 100))
	end
end

local function startFeed()
	if running then return end
	running = true
	setSwitch(true)
	local s = tonumber(SecInput.Text) or 0
	local m = tonumber(MsInput.Text) or 0
	local interval = math.max(s + m/1000, MIN_INTERVAL)
	setStatus("运行中", Color3.fromRGB(255, 200, 220), Color3.fromRGB(255, 100, 150))
	local last = 0
	feedConn = RunService.Heartbeat:Connect(function()
		if not running then return end
		local now = tick()
		if now - last >= interval then
			last = now
			doFeed()
		end
	end)
end

local function stopFeed()
	running = false
	if feedConn then feedConn:Disconnect(); feedConn = nil end
	setSwitch(false)
	setStatus("已停止", Color3.fromRGB(200, 180, 190), Color3.fromRGB(255, 120, 160))
	DistTxt.Text = "-- 格"
	DistTxt.TextColor3 = Color3.fromRGB(200, 160, 170)
end

local function toggleFold()
	expanded = not expanded
	local sz = expanded and UDim2.new(0, 260, 0, 302) or UDim2.new(0, 260, 0, 29)
	tween(Main, {Size = sz}, 0.3)
	CollapseBtn.Text = expanded and "v" or ">"
end

local function applyScale(targetScale)
	curScale = targetScale
	ZoomBtn.Text = math.floor(curScale * 100) .. "%"
	TweenService:Create(Scaler, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Scale = curScale
	}):Play()
end

local function teleportToTeto()
	local t = lastTarget or getTarget()
	if not t then return end
	local char = player.Character
	if not char then return end
	
	local targetCF
	if t:IsA("Model") then
		local hrp = t:FindFirstChild("HumanoidRootPart")
		if hrp then
			targetCF = hrp.CFrame
		elseif t.PrimaryPart then
			targetCF = t.PrimaryPart.CFrame
		else
			for _, v in ipairs(t:GetDescendants()) do
				if v:IsA("BasePart") then
					targetCF = v.CFrame
					break
				end
			end
		end
	elseif t:IsA("BasePart") then
		targetCF = t.CFrame
	end
	
	if not targetCF then return end
	
	local frontPos = targetCF.Position + targetCF.LookVector * 3
	char:MoveTo(frontPos)
	
	local tp = getPos(t)
	local pp = getPPos()
	if tp and pp then
		local d = (tp - pp).Magnitude
		DistTxt.Text = string.format("%.1f 格", d)
		if d <= MAX_DIST then
			DistTxt.TextColor3 = Color3.fromRGB(255, 160, 200)
			setStatus("在范围内", Color3.fromRGB(255, 220, 230), Color3.fromRGB(255, 100, 150))
		else
			DistTxt.TextColor3 = Color3.fromRGB(255, 120, 120)
			setStatus("距离过远", Color3.fromRGB(220, 180, 190), Color3.fromRGB(255, 140, 100))
		end
	end
end

