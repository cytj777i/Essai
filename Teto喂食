-- 后台监控
local monitorConn
monitorConn = RunService.Heartbeat:Connect(function()
	if not Gui or not Gui.Parent then
		if monitorConn then monitorConn:Disconnect() end
		return
	end
	if running then return end
	if tick() % 1.2 < 0.05 then
		local t = lastTarget or getTarget()
		lastTarget = t
		if t then
			local tp = getPos(t)
			local pp = getPPos()
			if tp and pp then
				local d = (tp - pp).Magnitude
				DistTxt.Text = string.format("%.1f 格", d)
				if d <= MAX_DIST then
					DistTxt.TextColor3 = Color3.fromRGB(255, 160, 200)
					setStatus("在范围内", Color3.fromRGB(255, 220, 230), Color3.fromRGB(255, 100, 150))
				else
					DistTxt.TextColor3 = Color3.fromRGB(255, 120, 120)
					setStatus("距离过远", Color3.fromRGB(220, 180, 190), Color3.fromRGB(255, 140, 100))
				end
			end
		else
			DistTxt.Text = "-- 格"
			setStatus("未找到Teto🧐", Color3.fromRGB(255, 120, 120), Color3.fromRGB(255, 80, 80))
		end
	end
end)

setStatus("就绪", Color3.fromRGB(220, 180, 190), Color3.fromRGB(255, 120, 160))
