-- ========== 工具函数 ==========
local function getTarget()
	local tiles = workspace:FindFirstChild("Tiles")
	if tiles then
		local t1 = tiles:FindFirstChild("Teto")
		if t1 then
			if t1:FindFirstChildWhichIsA("ClickDetector") then return t1 end
			local t2 = t1:FindFirstChild("Teto")
			if t2 and t2:FindFirstChildWhichIsA("ClickDetector") then return t2 end
		end
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj.Name == "Teto" and obj:FindFirstChildWhichIsA("ClickDetector") then
			return obj
		end
	end
	return nil
end

local function getCD(obj)
	return obj and obj:FindFirstChildWhichIsA("ClickDetector") or nil
end

local function getPos(obj)
	if not obj then return nil end
	if obj:IsA("Model") then
		if obj.PrimaryPart then return obj.PrimaryPart.Position end
		local hrp = obj:FindFirstChild("HumanoidRootPart")
		if hrp then return hrp.Position end
		for _, v in ipairs(obj:GetDescendants()) do
			if v:IsA("BasePart") then return v.Position end
		end
	elseif obj:IsA("BasePart") then
		return obj.Position
	end
	return nil
end

local function getPPos()
	local char = player.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	return hrp and hrp.Position or nil
end

