end)

-- 输入校验（整数 + 0秒0毫秒自动修正为1毫秒）
SecInput.FocusLost:Connect(function()
	local v = tonumber(SecInput.Text)
	if not v then v = 0 end
	v = math.floor(math.max(v, 0))
	SecInput.Text = tostring(v)
	
	local ms = tonumber(MsInput.Text) or 0
	ms = math.floor(math.max(ms, 0))
	if v == 0 and ms == 0 then
		ms = 1
		MsInput.Text = "1"
	end
	
	if running then stopFeed(); task.wait(0.1); startFeed() end
end)

MsInput.FocusLost:Connect(function()
	local v = tonumber(MsInput.Text)
	if not v then v = 0 end
	v = math.floor(math.max(v, 0))
	if v > 999 then v = 999 end
	MsInput.Text = tostring(v)
	
	local s = tonumber(SecInput.Text) or 0
	s = math.floor(math.max(s, 0))
	if s == 0 and v == 0 then
		v = 1
		MsInput.Text = "1"
	end
	
	if running then stopFeed(); task.wait(0.1); startFeed() end
end)

-- 按钮按压反馈
local function pressEffect(btn)
	btn.MouseButton1Down:Connect(function()
		tween(btn, {BackgroundTransparency = math.max(btn.BackgroundTransparency - 0.15, 0)}, 0.08)
	end)
	btn.MouseButton1Up:Connect(function()
		tween(btn, {BackgroundTransparency = math.min(btn.BackgroundTransparency + 0.15, 1)}, 0.08)
	end)
end
pressEffect(SwitchHit)
pressEffect(CloseBtn)
pressEffect(ZoomBtn)

