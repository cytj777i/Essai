    NPCESPEnabled = true
    
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("Model") and descendant ~= LocalPlayer.Character then
            local humanoid = descendant:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local isPlayer = false
                for _, player in ipairs(Players:GetPlayers()) do
                    if player.Character == descendant then
                        isPlayer = true
                        break
                    end
                end
                if not isPlayer then
                    CreateNPCESP(descendant)
                end
            end
        end
    end
    Notify("NPC透视", "NPC透视已开启")
end

local function DisableNPCESP()
    if not NPCESPEnabled then return end
    NPCESPEnabled = false

    for model, _ in pairs(NPCHighlights) do
        RemoveNPCESP(model)
    end
    Notify("NPC透视", "NPC透视已关闭")
end

