    wait(0.5)
    UpdatePlayerList()
    -- 如果玩家选择UI存在，更新它
    if PlayerSelectionUI and PlayerSelectionUI.Parent then
        PlayerSelectionUI:Destroy()
        CreatePlayerSelectionUI()
    end
end

local function OnPlayerRemoving(player)
    wait(0.5)
    UpdatePlayerList()
    -- 如果选中的玩家离开了，清除选择
    if SelectedPlayer == player.Name then
        SelectedPlayer = nil
    end
    -- 如果玩家选择UI存在，更新它
    if PlayerSelectionUI and PlayerSelectionUI.Parent then
        PlayerSelectionUI:Destroy()
        CreatePlayerSelectionUI()
    end
end

-- 自然灾害预测功能
local function PredictDisaster()
    if not NaturalDisasterPredictionEnabled then return end
    
    local localPlayer = game.Players.LocalPlayer
    if not localPlayer.Character then return end
    
    local survivalTag = localPlayer.Character:FindFirstChild("SurvivalTag")
    if survivalTag then
        local disasterName = survivalTag.Value
        
        -- 只要有灾害就发送通知（无论是否变化）
        local disasterText = ""
        
        if disasterName == "Blizzard" then
            disasterText = "下一个灾难是：暴风雪"
        elseif disasterName == "Sandstorm" then
            disasterText = "下一个灾难是：沙尘暴"
        elseif disasterName == "Tornado" then
            disasterText = "下一个灾难是：龙卷风"
        elseif disasterName == "Volcanic Eruption" then
            disasterText = "下一个灾难是：火山"
        elseif disasterName == "Flash Flood" then
            disasterText = "下一个灾难是：洪水"
        elseif disasterName == "Deadly Virus" then
            disasterText = "下一个灾难是：病毒"
        elseif disasterName == "Tsunami" then
            disasterText = "下一个灾难是：海啸"
        elseif disasterName == "Acid Rain" then
            disasterText = "下一个灾难是：酸雨"
        elseif disasterName == "Fire" then
            disasterText = "下一个灾难是：火焰"
        elseif disasterName == "Meteor Shower" then
            disasterText = "下一个灾难是：流星雨"
        elseif disasterName == "Earthquake" then
            disasterText = "下一个灾难是：地震"
        elseif disasterName == "Thunder Storm" then
            disasterText = "下一个灾难是：暴风雨"
        else
            disasterText = "下一个灾难是：" .. disasterName
        end
        
        -- 发送通知
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "灾害预测",
            Text = disasterText,
            Icon = "rbxassetid://18941716391",
            Duration = 5,
        })
    end
end

local function StartPrediction()
    NaturalDisasterPredictionEnabled = true
    PredictionCoroutine = coroutine.create(function()
        while NaturalDisasterPredictionEnabled do
            PredictDisaster()
            wait(predictionInterval)
        end
    end)
    coroutine.resume(PredictionCoroutine)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "灾害预测",
        Text = "灾害预测已启用",
        Icon = "rbxassetid://18941716391",
        Duration = 3,
    })
end

local function StopPrediction()
    NaturalDisasterPredictionEnabled = false
    if PredictionCoroutine then
        coroutine.close(PredictionCoroutine)
        PredictionCoroutine = nil
    end
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "灾害预测",
        Text = "灾害预测已关闭",
        Icon = "rbxassetid://18941716391",
        Duration = 3,
    })
end

local function ToggleDisasterPrediction()
    if NaturalDisasterPredictionEnabled then
        StopPrediction()
    else
        StartPrediction()
    end
end

