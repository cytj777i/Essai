-- ==================== 无敌模式 ====================
local godModeConnections = {}
local godModeCharacterConn = nil
local godModeHumanoid = nil
local godModeLastHealth = nil

local function clearGodModeConnections()
    for _, conn in ipairs(godModeConnections) do pcall(function() conn:Disconnect() end) end
    godModeConnections = {}
    if godModeCharacterConn then pcall(function() godModeCharacterConn:Disconnect() end) godModeCharacterConn = nil end
    godModeHumanoid = nil
    godModeLastHealth = nil
end

local function bindGodModeToHumanoid(humanoid)
    if not humanoid or not godModeEnabled then return end
    godModeHumanoid = humanoid
    godModeLastHealth = humanoid.Health
    local healthChangedConn = humanoid.HealthChanged:Connect(function(newHealth)
        if not godModeEnabled then return end
        if newHealth < godModeLastHealth then pcall(function() humanoid.Health = humanoid.MaxHealth end) end
        godModeLastHealth = humanoid.MaxHealth
    end)
    table.insert(godModeConnections, healthChangedConn)
    local propChangedConn = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if not godModeEnabled then return end
        pcall(function() if humanoid.Health < humanoid.MaxHealth then humanoid.Health = humanoid.MaxHealth end end)
    end)
    table.insert(godModeConnections, propChangedConn)
    local heartbeatConn = RunService.Heartbeat:Connect(function()
        if not godModeEnabled then return end
        pcall(function()
            if humanoid and humanoid.Parent then
                if humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then humanoid.Health = humanoid.MaxHealth end
                if humanoid.MaxHealth < 100 then humanoid.MaxHealth = 100 end
            end
        end)
    end)
    table.insert(godModeConnections, heartbeatConn)
    local stateChangedConn = humanoid.StateChanged:Connect(function(oldState, newState)
        if not godModeEnabled then return end
        if newState == Enum.HumanoidStateType.Dead then
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) humanoid.Health = humanoid.MaxHealth end)
        end
    end)
    table.insert(godModeConnections, stateChangedConn)
    pcall(function() humanoid.Health = humanoid.MaxHealth end)
end

local function startGodMode()
    clearGodModeConnections()
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then bindGodModeToHumanoid(humanoid) end
    end
    godModeCharacterConn = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
        if not godModeEnabled then return end
        task.wait(0.1)
        local humanoid = newCharacter:FindFirstChildOfClass("Humanoid")
        if humanoid then bindGodModeToHumanoid(humanoid) end
    end)
    if character then
        local humanoidWatcher = character.ChildAdded:Connect(function(child)
            if not godModeEnabled then return end
            if child:IsA("Humanoid") then task.wait(0.05) bindGodModeToHumanoid(child) end
        end)
        table.insert(godModeConnections, humanoidWatcher)
    end
end

local function stopGodMode()
    clearGodModeConnections()
end

-- 刷怪循环
local function startSpawning()
    if spawnLoop then task.cancel(spawnLoop) end
    spawnLoop = task.spawn(function()
        while autoSpawnEnabled do
            if SpawnCandidateResponse then
                local candidates = {}
                for i = 1, 5 do
                    if fixedSpawnEnabled and fixedSpawnPosition then
                        table.insert(candidates, fixedSpawnPosition)
                    else
                        local character = LocalPlayer.Character
                        local myHrp = character and character:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            local randomOffset = Vector3.new(math.random(-30, 30), 0, math.random(-30, 30))
                            table.insert(candidates, myHrp.Position + randomOffset)
                        end
                    end
                end
                if #candidates > 0 then pcall(function() SpawnCandidateResponse:FireServer(candidates) end) end
            end
            task.wait(spawnInterval)
        end
    end)
end

local function stopSpawning()
    if spawnLoop then task.cancel(spawnLoop) spawnLoop = nil end
end

-- ==================== 枪械功能 ====================

local function applyFireRateOnly()
    local character = LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    for attrName, attrValue in pairs(tool:GetAttributes()) do
        local lowerName = string.lower(attrName)
        if lowerName:find("rate") or lowerName:find("cooldown") or lowerName:find("delay") then
            if type(attrValue) == "number" then tool:SetAttribute(attrName, 0) end
        elseif lowerName:find("rpm") then
            if type(attrValue) == "number" then tool:SetAttribute(attrName, 99999) end
        end
    end
    for _, obj in pairs(tool:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            local lowerName = string.lower(obj.Name)
            if lowerName:find("rate") or lowerName:find("cooldown") or lowerName:find("time") or lowerName:find("delay") then obj.Value = 0
            elseif lowerName:find("rpm") then obj.Value = 99999 end
        end
        if obj:IsA("ModuleScript") then
            pcall(function()
                local configTable = require(obj)
                if type(configTable) == "table" then
                    for k, v in pairs(configTable) do
                        local keyStr = string.lower(tostring(k))
                        if type(v) == "number" then
                            if keyStr:find("firerate") or keyStr:find("cooldown") or keyStr:find("delay") or keyStr:find("waittime") then configTable[k] = 0.001
                            elseif keyStr:find("rpm") then configTable[k] = 99999 end
                        end
                    end
                end
            end)
        end
    end
end

local function applyReloadOnly()
    local character = LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    for attrName, attrValue in pairs(tool:GetAttributes()) do
        local lowerName = string.lower(attrName)
        if lowerName:find("reload") then if type(attrValue) == "number" then tool:SetAttribute(attrName, 0) end end
    end
    for _, obj in pairs(tool:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            if string.lower(obj.Name):find("reload") then obj.Value = 0 end
        end
        if obj:IsA("ModuleScript") then
            pcall(function()
                local configTable = require(obj)
                if type(configTable) == "table" then
                    for k, v in pairs(configTable) do
                        local keyStr = string.lower(tostring(k))
                        if type(v) == "number" then
                            if keyStr:find("reload") or keyStr:find("reloadtime") or keyStr:find("reloadspeed") then configTable[k] = 0 end
                        end
                    end
                end
            end)
        end
    end
end

local function applyNoRecoilOnly()
    local character = LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    for attrName, attrValue in pairs(tool:GetAttributes()) do
        local lowerName = string.lower(attrName)
        if lowerName:find("recoil") or lowerName:find("kick") or lowerName:find("spread") or lowerName:find("accuracy") or lowerName:find("camshake") or lowerName:find("shake") or lowerName:find("viewkick") or lowerName:find("bloom") or lowerName:find("sway") or lowerName:find("stability") then
            if typeof(attrValue) == "Vector3" then tool:SetAttribute(attrName, Vector3.new(0, 0, 0))
            elseif typeof(attrValue) == "Vector2" then tool:SetAttribute(attrName, Vector2.new(0, 0))
            elseif type(attrValue) == "number" then tool:SetAttribute(attrName, 0) end
        end
    end
    for _, obj in pairs(tool:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            local lowerName = string.lower(obj.Name)
            if lowerName:find("recoil") or lowerName:find("kick") or lowerName:find("spread") or lowerName:find("accuracy") or lowerName:find("camshake") or lowerName:find("shake") or lowerName:find("viewkick") or lowerName:find("muzzle") or lowerName:find("bloom") or lowerName:find("sway") or lowerName:find("stability") then obj.Value = 0 end
        end
        if obj:IsA("Vector3Value") then
            local lowerName = string.lower(obj.Name)
            if lowerName:find("recoil") or lowerName:find("kick") or lowerName:find("offset") or lowerName:find("spread") then obj.Value = Vector3.new(0, 0, 0) end
        end
        if obj:IsA("ModuleScript") then
            pcall(function()
                local configTable = require(obj)
                if type(configTable) == "table" then
                    for k, v in pairs(configTable) do
                        local keyStr = string.lower(tostring(k))
                        if keyStr:find("recoil") or keyStr:find("kick") or keyStr:find("spread") or keyStr:find("accuracy") or keyStr:find("weaponkick") or keyStr:find("camshake") or keyStr:find("shake") or keyStr:find("viewkick") or keyStr:find("muzzle") or keyStr:find("gunshake") or keyStr:find("bloom") or keyStr:find("sway") or keyStr:find("stability") or keyStr:find("weaponsway") then
                            if typeof(v) == "Vector3" then configTable[k] = Vector3.new(0, 0, 0)
                            elseif typeof(v) == "Vector2" then configTable[k] = Vector2.new(0, 0)
                            elseif type(v) == "number" then configTable[k] = 0 end
                        end
                    end
                end
            end)
        end
    end
end

-- 禁用怪物碰撞
local function disableBaddieCollision(baddie)
    for _, part in ipairs(baddie:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
end

-- 冻结怪物
local function freezeBaddie(baddie)
    local hum = baddie:FindFirstChild("Humanoid")
    if hum then hum.WalkSpeed = 0; hum.JumpPower = 0; pcall(function() hum.AutoRotate = false end) end
    local animator = baddie:FindFirstChild("Animator", true)
    if animator then for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:AdjustSpeed(0) end end
end

-- 怪物聚集到镜头前
local function startStackingBaddies()
    if stackLoop then task.cancel(stackLoop) end
    stackLoop = task.spawn(function()
        while stackBaddiesEnabled do
            local character = LocalPlayer.Character
            local myHrp = character and character:FindFirstChild("HumanoidRootPart")
            if not myHrp then task.wait(0.1) continue end
            local camCF = CurrentCamera.CFrame
            local targetPos = camCF.Position + (camCF.LookVector * stackDistance)
            for _, baddie in ipairs(RoamingBaddies:GetChildren()) do
                if baddie:IsA("Model") then
                    local hum = baddie:FindFirstChild("Humanoid")
                    local hrp = baddie:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and hrp then
                        disableBaddieCollision(baddie)
                        hrp.CFrame = CFrame.new(targetPos)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end

local function stopStackingBaddies()
    if stackLoop then task.cancel(stackLoop) stackLoop = nil end
end

-- 传送至面前地面
local function startStackingGround()
    if stackGroundLoop then task.cancel(stackGroundLoop) end
    stackGroundLoop = task.spawn(function()
        while stackGroundEnabled do
            local character = LocalPlayer.Character
            local myHrp = character and character:FindFirstChild("HumanoidRootPart")
            if not myHrp then task.wait(0.1) continue end
            local myPos = myHrp.Position
            local lookDir = myHrp.CFrame.LookVector
            local targetHorizontal = Vector3.new(
                myPos.X + lookDir.X * stackGroundDistance,
                myPos.Y,
                myPos.Z + lookDir.Z * stackGroundDistance
            )
            local groundY = findGroundY(targetHorizontal)
            if not groundY then task.wait(0.05) continue end
            local myGroundY = findGroundY(myPos)
            if myGroundY and groundY > myGroundY + 10 then groundY = myGroundY end
            for _, baddie in ipairs(RoamingBaddies:GetChildren()) do
                if baddie:IsA("Model") then
                    local hum = baddie:FindFirstChild("Humanoid")
                    local hrp = baddie:FindFirstChild("HumanoidRootPart")
                    if hum and hum.Health > 0 and hrp then
                        disableBaddieCollision(baddie)
                        freezeBaddie(baddie)
                        local baddieHorizontal = Vector3.new(hrp.Position.X, myPos.Y, hrp.Position.Z)
                        local baddieGroundY = findGroundY(baddieHorizontal)
                        local finalGroundY = baddieGroundY or groundY
                        local targetPos = Vector3.new(targetHorizontal.X, finalGroundY + 2.5, targetHorizontal.Z)
                        local ceilingY = findCeilingY(targetPos)
                        if ceilingY and (targetPos.Y + 5) > ceilingY then targetPos = Vector3.new(targetPos.X, ceilingY - 5, targetPos.Z) end
                        hrp.CFrame = CFrame.new(targetPos)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end

