        Desc = "传送到怪物周围的间距",
        Value = { Min = 5, Max = 50, Default = 15 },
        Step = 1,
        Callback = function(value) farmDistance = value end
    })
    farmSection:Slider({
        Title = "附近检测距离",
        Desc = "此范围内有怪则不传送",
        Value = { Min = 10, Max = 100, Default = 30 },
        Step = 5,
        Callback = function(value) nearbyCheckDistance = value end
    })

    local defSection = tab78:Section({Title = "物理与空间排斥力场", Icon = "radio", Opened = true})
    defSection:Toggle({
        Title = "启动绝对排斥力场",
        Desc = "开启无敌防近身保护",
        Value = false,
        Callback = function(state) auraEnabled = state end
    })
    defSection:Slider({
        Title = "力场范围 (半径)",
        Desc = "调节保护罩的大小",
        Value = { Min = 5, Max = 50, Default = 15 },
        Step = 1,
        Callback = function(value) auraRadius = value end
    })

    local spawnSection = tab78:Section({Title = "刷怪控制器", Icon = "server", Opened = true})
    spawnSection:Toggle({
        Title = "启用疯狂刷怪(不确定有效性)",
        Desc = "利用游戏事件高频召唤怪物",
        Value = false,
        Callback = function(state)
            autoSpawnEnabled = state
            if state then startSpawning() else stopSpawning() end
        end
    })
    spawnSection:Slider({
        Title = "刷怪频率 (秒)",
        Desc = "发送刷怪请求的时间间隔",
        Value = { Min = 0.1, Max = 5, Default = 0.5 },
        Step = 0.1,
        Callback = function(value) spawnInterval = value end
    })
    spawnSection:Toggle({
        Title = "固定位置刷怪",
        Desc = "让所有怪物固定刷在设定的位置",
        Value = false,
        Callback = function(state) fixedSpawnEnabled = state end
    })
    spawnSection:Button({
        Title = "将当前位置设为刷怪点",
        Icon = "map-pin",
        Callback = function()
            local character = LocalPlayer.Character
            local myHrp = character and character:FindFirstChild("HumanoidRootPart")
            if myHrp then fixedSpawnPosition = myHrp.Position - Vector3.new(0, 2, 0) end
        end
    })

    local stackSection = tab78:Section({Title = "怪物聚集模块", Icon = "align-center", Opened = true})
    stackSection:Toggle({
        Title = "启用怪物聚集 (跟随镜头)",
        Desc = "持续将所有怪送到镜头前中心",
        Value = false,
        Callback = function(state)
            stackBaddiesEnabled = state
            if state then
                if stackGroundEnabled then stackGroundEnabled = false stopStackingGround() end
                if teleportToHeadEnabled then teleportToHeadEnabled = false stopHeadTeleport() end
                startStackingBaddies()
            else
                stopStackingBaddies()
            end
        end
    })
    stackSection:Toggle({
        Title = "启用怪物聚集 (面前地面)",
        Desc = "持续将所有怪送到你正前方地面上",
        Value = false,
        Callback = function(state)
            stackGroundEnabled = state
            if state then
                if stackBaddiesEnabled then stackBaddiesEnabled = false stopStackingBaddies() end
                if teleportToHeadEnabled then teleportToHeadEnabled = false stopHeadTeleport() end
                startStackingGround()
            else
                stopStackingGround()
            end
        end
    })
    stackSection:Slider({
        Title = "聚集距离",
        Desc = "怪物距离你/摄像头的远近",
        Value = { Min = 3, Max = 30, Default = 10 },
        Step = 1,
        Callback = function(value)
            stackDistance = value
            stackGroundDistance = value
        end
    })

    Window:OnClose(function()
        windowOpen = false
        if rainbowBorderAnimation then rainbowBorderAnimation:Disconnect() rainbowBorderAnimation = nil end
    end)

    Window:OnDestroy(function()
        windowOpen = false
        if rainbowBorderAnimation then rainbowBorderAnimation:Disconnect() rainbowBorderAnimation = nil end
        for _, animation in pairs(fontColorAnimations) do animation:Disconnect() end
        fontColorAnimations = {}
    end)
end

createUI()
