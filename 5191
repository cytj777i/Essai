-- 传送至最近怪头顶
local function startHeadTeleport()
    if headTeleportLoop then task.cancel(headTeleportLoop) end
    if headTeleportConnection then headTeleportConnection:Disconnect() end
    headTeleportTarget = nil
    headTeleportLoop = task.spawn(function()
        while teleportToHeadEnabled do
            local character = LocalPlayer.Character
            local myHrp = character and character:FindFirstChild("HumanoidRootPart")
            local myHum = character and character:FindFirstChild("Humanoid")
            if not myHrp or (myHum and myHum.Health <= 0) then task.wait(0.1) continue end
            if headTeleportTarget then
                local targetHum = headTeleportTarget:FindFirstChild("Humanoid")
                local targetHrp = headTeleportTarget:FindFirstChild("HumanoidRootPart")
                if not targetHum or targetHum.Health <= 0 or not targetHrp or not headTeleportTarget.Parent then headTeleportTarget = nil end
            end
            if not headTeleportTarget then headTeleportTarget = getNearestBaddie() end
            if headTeleportTarget then
                local targetHrp = headTeleportTarget:FindFirstChild("HumanoidRootPart")
                if targetHrp then
                    local targetPos = targetHrp.Position
                    local headHeight = targetPos.Y + headTeleportHeight
                    local ceilingY = findCeilingY(targetPos)
                    if ceilingY then
                        local maxAllowedHeight = ceilingY - 3
                        if headHeight > maxAllowedHeight then headHeight = math.max(targetPos.Y + headTeleportMinHeight, maxAllowedHeight) end
                    end
                    if headHeight < targetPos.Y + headTeleportMinHeight then headHeight = targetPos.Y + headTeleportMinHeight end
                    if headHeight > targetPos.Y + headTeleportMaxHeight then headHeight = targetPos.Y + headTeleportMaxHeight end
                    local teleportPos = Vector3.new(targetPos.X, headHeight, targetPos.Z)
                    myHrp.CFrame = CFrame.new(teleportPos)
                    if myHrp.AssemblyLinearVelocity then myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
                    if myHrp.AssemblyAngularVelocity then myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end
                end
            else task.wait(0.2) end
            task.wait(0.05)
        end
    end)
    headTeleportConnection = RunService.Heartbeat:Connect(function()
        if not teleportToHeadEnabled then return end
        local character = LocalPlayer.Character
        local myHrp = character and character:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        if headTeleportTarget then
            local targetHrp = headTeleportTarget:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                local targetPos = targetHrp.Position
                local headHeight = targetPos.Y + headTeleportHeight
                local ceilingY = findCeilingY(targetPos)
                if ceilingY then
                    local maxAllowedHeight = ceilingY - 3
                    if headHeight > maxAllowedHeight then headHeight = math.max(targetPos.Y + headTeleportMinHeight, maxAllowedHeight) end
                end
                if headHeight < targetPos.Y + headTeleportMinHeight then headHeight = targetPos.Y + headTeleportMinHeight end
                if headHeight > targetPos.Y + headTeleportMaxHeight then headHeight = targetPos.Y + headTeleportMaxHeight end
                local desiredPos = Vector3.new(targetPos.X, headHeight, targetPos.Z)
                myHrp.CFrame = CFrame.new(desiredPos)
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end)
end

local function stopHeadTeleport()
    if headTeleportLoop then task.cancel(headTeleportLoop) headTeleportLoop = nil end
    if headTeleportConnection then headTeleportConnection:Disconnect() headTeleportConnection = nil end
    headTeleportTarget = nil
end

