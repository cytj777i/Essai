-- 获取最近存活的怪物
local function getNearestBaddie()
    local nearest = nil
    local minDist = math.huge
    local character = LocalPlayer.Character
    local myHrp = character and character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    for _, baddie in ipairs(RoamingBaddies:GetChildren()) do
        if baddie:IsA("Model") then
            local hum = baddie:FindFirstChild("Humanoid")
            local hrp = baddie:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local dist = (myHrp.Position - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = baddie
                end
            end
        end
    end
    return nearest
end

-- 获取指定范围内的怪物数量
local function getBaddiesInRange(range)
    local count = 0
    local character = LocalPlayer.Character
    local myHrp = character and character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return 0 end
    for _, baddie in ipairs(RoamingBaddies:GetChildren()) do
        if baddie:IsA("Model") then
            local hum = baddie:FindFirstChild("Humanoid")
            local hrp = baddie:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                if (myHrp.Position - hrp.Position).Magnitude <= range then
                    count = count + 1
                end
            end
        end
    end
    return count
end

-- 收集所有需要排除的实例（玩家角色 + 所有怪物）
local function getRaycastBlacklist()
    local blacklist = {LocalPlayer.Character}
    for _, baddie in ipairs(RoamingBaddies:GetChildren()) do
        if baddie:IsA("Model") then
            table.insert(blacklist, baddie)
        end
    end
    return blacklist
end

-- 地面检测：从某位置找到正下方的地面Y坐标
local function findGroundY(position)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = getRaycastBlacklist()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local origin = Vector3.new(position.X, position.Y + 5, position.Z)
    local direction = Vector3.new(0, -50, 0)
    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result then return result.Position.Y end
    origin = Vector3.new(position.X, position.Y + 20, position.Z)
    direction = Vector3.new(0, -100, 0)
    result = Workspace:Raycast(origin, direction, raycastParams)
    if result then return result.Position.Y end
    return nil
end

-- 天花板检测：从某位置找到正上方的天花板Y坐标
local function findCeilingY(position)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = getRaycastBlacklist()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local origin = Vector3.new(position.X, position.Y + 2, position.Z)
    local direction = Vector3.new(0, 100, 0)
    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result then return result.Position.Y end
    return nil
end

-- 房间检测系统
local function getRoomSafePosition(targetPosition)
    local character = LocalPlayer.Character
    local myHrp = character and character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = getRaycastBlacklist()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local directions = {
        Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
        Vector3.new(0, 1, 0), Vector3.new(0, -1, 0),
    }
    local wallDistances = {}
    local hasGround = false
    local groundY = nil
    for _, dir in ipairs(directions) do
        local origin = targetPosition + (dir * 0.5)
        local result = Workspace:Raycast(origin, dir * 100, raycastParams)
        if result then
            local dist = (result.Position - targetPosition).Magnitude
            table.insert(wallDistances, dist)
            if dir.Y < 0 then hasGround = true; groundY = result.Position.Y end
        else
            table.insert(wallDistances, math.huge)
        end
    end
    local horizontalWalls = 0
    for i = 1, 4 do if wallDistances[i] < 50 then horizontalWalls = horizontalWalls + 1 end end
    if horizontalWalls < 2 or not hasGround then return nil end
    if not groundY then groundY = findGroundY(targetPosition) end
    if not groundY then return nil end
    local myPos = myHrp.Position
    local toPlayer = myPos - targetPosition
    toPlayer = Vector3.new(toPlayer.X, 0, toPlayer.Z)
    if toPlayer.Magnitude < 0.1 then toPlayer = Vector3.new(0, 0, 1) end
    toPlayer = toPlayer.Unit
    local destination = Vector3.new(
        targetPosition.X + toPlayer.X * farmDistance,
        groundY + 3,
        targetPosition.Z + toPlayer.Z * farmDistance
    )
    local destGroundY = findGroundY(destination)
    if not destGroundY or destGroundY < groundY - 10 then return nil end
    destination = Vector3.new(destination.X, destGroundY + 3, destination.Z)
    return destination
end

-- 墙壁检测
local function isVisible(targetPosition)
    if not wallCheckEnabled then return true end
    local character = LocalPlayer.Character
    if not character then return false end
    local origin = CurrentCamera.CFrame.Position
    local direction = targetPosition - origin
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = getRaycastBlacklist()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, raycastParams)
    return result == nil
end

-- 自动装备枪械函数
local function autoEquipGun()
    if not autoEquipGunEnabled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    task.wait(0.3)
    local tools = {}
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then table.insert(tools, item) end
    end
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then return end
    end
    local targetIndex = selectedGunSlot
    if targetIndex <= #tools then
        local targetTool = tools[targetIndex]
        if targetTool then
            pcall(function() humanoid:EquipTool(targetTool) end)
        end
    elseif #tools > 0 then
        pcall(function() humanoid:EquipTool(tools[1]) end)
    end
end

