local function AddToQueue(obj, cat)
    for _, e in ipairs(State.LoopQueue) do if e.Obj == obj and e.Cat == cat then return end end
    table.insert(State.LoopQueue, {Obj = obj, Cat = cat})
end
local function RemoveFromQueue(obj, cat)
    for i = #State.LoopQueue, 1, -1 do
        if State.LoopQueue[i].Obj == obj and State.LoopQueue[i].Cat == cat then table.remove(State.LoopQueue, i) end
    end
end
local function InQueue(obj, cat)
    for _, e in ipairs(State.LoopQueue) do if e.Obj == obj and e.Cat == cat then return true end end
    return false
end

local function UpdateButtonVisuals(b, obj, cat)
    local xraySet = State.XRaySelected[cat]
    local isXRay = xraySet and xraySet[obj] == true
    local isSingle = State.SingleTarget == obj and State.SingleCategory == cat
    local isLoop = InQueue(obj, cat)

    local ind = b:FindFirstChild("XRayInd")
    if not ind then
        ind = Instance.new("Frame")
        ind.Name = "XRayInd"
        ind.Size = UDim2.new(0, 3, 1, 0)
        ind.Position = UDim2.new(0, 0, 0, 0)
        ind.BackgroundColor3 = XRAY_ACCENT
        ind.BorderSizePixel = 0
        ind.Parent = b
    end
    ind.Visible = isXRay
    ind.BackgroundColor3 = XRAY_ACCENT

    if State.TeleportMode == "Single" then
        if isSingle then
            b.BackgroundColor3 = Color3.fromRGB(37, 99, 235)
            b.BackgroundTransparency = 0.25
            b.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            b.BackgroundColor3 = Color3.fromRGB(15, 15, 28)
            b.BackgroundTransparency = 0.6
            b.TextColor3 = Color3.fromRGB(180, 180, 195)
        end
    else
        if isLoop then
            b.BackgroundColor3 = Color3.fromRGB(124, 58, 237)
            b.BackgroundTransparency = 0.25
            b.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            b.BackgroundColor3 = Color3.fromRGB(15, 15, 28)
            b.BackgroundTransparency = 0.6
            b.TextColor3 = Color3.fromRGB(180, 180, 195)
        end
    end
end

local function RefreshAllListVisuals()
    for cat, entries in pairs(ListEntries) do
        for _, e in ipairs(entries) do
            if e.Button and e.Object then UpdateButtonVisuals(e.Button, e.Object, cat) end
        end
    end
end

local function UpdateList(listData, objects, cat)
    for _, e in ipairs(ListEntries[cat]) do if e.Button then e.Button:Destroy() end end
    ListEntries[cat] = {}

    listData.Header.Text = listData.Header.Text:gsub("%[.-%]", "[" .. #objects .. "]")

    if State.LoopSelectAll[cat] then
        for i = #State.LoopQueue, 1, -1 do
            if State.LoopQueue[i].Cat == cat then table.remove(State.LoopQueue, i) end
        end
        for _, obj in ipairs(objects) do
            AddToQueue(obj, cat)
        end
    end

    if State.XRaySelectAll[cat] then
        for _, obj in ipairs(objects) do
            State.XRaySelected[cat][obj] = true
        end
    end

    for _, obj in ipairs(objects) do
        (function(currentObj, currentCat)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -2, 0, 15)
            b.BackgroundColor3 = Color3.fromRGB(15, 15, 28)
            b.BackgroundTransparency = 0.6
            b.BorderSizePixel = 0
            b.Text = " " .. currentObj.Name
            b.TextColor3 = Color3.fromRGB(180, 180, 195)
            b.TextSize = 8
            b.Font = Enum.Font.Gotham
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.AutoButtonColor = false
            b.Parent = listData.Scroll

            UpdateButtonVisuals(b, currentObj, currentCat)

            b.MouseEnter:Connect(function()
                local active = false
                if State.TeleportMode == "Single" then
                    active = (State.SingleTarget == currentObj and State.SingleCategory == currentCat)
                else
                    active = InQueue(currentObj, currentCat)
                end
                if not active then b.BackgroundTransparency = 0.35 end
            end)
            b.MouseLeave:Connect(function() UpdateButtonVisuals(b, currentObj, currentCat) end)

            b.MouseButton1Click:Connect(function()
                if State.XRayMode then
                    local sel = State.XRaySelected[currentCat][currentObj] == true
                    if sel then
                        State.XRaySelected[currentCat][currentObj] = nil
                        ClearXRayObj(currentObj)
                        if State.XRaySelectAll[currentCat] then
                            State.XRaySelectAll[currentCat] = false
                            local ui = LoopSelectAllUI[currentCat]
                            if ui then ui.XRayCheckMark.Visible = false end
                        end
                    else
                        State.XRaySelected[currentCat][currentObj] = true
                    end
                    UpdateButtonVisuals(b, currentObj, currentCat)
                    UpdateXRay()
                else
                    if State.TeleportMode == "Single" then
                        if State.SingleTarget == currentObj and State.SingleCategory == currentCat then
                            State.SingleTarget = nil
                            State.SingleCategory = nil
                        else
                            State.SingleTarget = currentObj
                            State.SingleCategory = currentCat
                        end
                        RefreshAllListVisuals()
                    else
                        if InQueue(currentObj, currentCat) then
                            RemoveFromQueue(currentObj, currentCat)
                            if State.LoopSelectAll[currentCat] then
                                State.LoopSelectAll[currentCat] = false
                                local ui = LoopSelectAllUI[currentCat]
                                if ui then ui.CheckMark.Visible = false end
                            end
                        else
                            AddToQueue(currentObj, currentCat)
                        end
                        RefreshAllListVisuals()
                    end
                end
            end)

            table.insert(ListEntries[cat], {Button = b, Object = currentObj})
        end)(obj, cat)
    end

    if State.SingleCategory == cat then
        local found = false
        for _, obj in ipairs(objects) do if obj == State.SingleTarget then found = true break end end
        if not found then State.SingleTarget = nil State.SingleCategory = nil end
    end
    -- 修复：避免 pairs 遍历中删除导致跳过
    local toClean = {}
    for obj, _ in pairs(State.XRaySelected[cat]) do
        if not obj or not obj.Parent then
            table.insert(toClean, obj)
        end
    end
    for _, obj in ipairs(toClean) do
        State.XRaySelected[cat][obj] = nil
        ClearXRayObj(obj)
    end
    for i = #State.LoopQueue, 1, -1 do
        if State.LoopQueue[i].Cat == cat then
            local found = false 
            
            for _, obj in ipairs(objects) do if obj == State.LoopQueue[i].Obj then found = true break end end
            if not found then table.remove(State.LoopQueue, i) end
        end
    end
end

local function CreateSection(title, defaultOpen)
    local section = Instance.new("Frame")
    section.BackgroundTransparency = 1
    section.BorderSizePixel = 0
    section.Parent = Content

    local header = Instance.new("TextButton")
    header.Size = UDim2.new(1, -4, 0, 22)
    header.Position = UDim2.new(0, 2, 0, 0)
    header.BackgroundColor3 = Color3.fromRGB(18, 20, 35)
    header.BackgroundTransparency = 0.5
    header.BorderSizePixel = 0
    header.Text = (defaultOpen and "  ▼ " or "  ▶ ") .. title
    header.TextColor3 = Color3.fromRGB(220, 220, 230)
    header.TextSize = 9
    header.Font = Enum.Font.GothamBold
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.AutoButtonColor = false
    header.Parent = section

    local body = Instance.new("Frame")
    body.Size = UDim2.new(1, 0, 0, 0)
    body.Position = UDim2.new(0, 0, 0, 22)
    body.BackgroundTransparency = 1
    body.BorderSizePixel = 0
    body.ClipsDescendants = true
    body.Visible = defaultOpen == true
    body.Parent = section

    local bodyLayout = Instance.new("UIListLayout")
    bodyLayout.Padding = UDim.new(0, 1)
    bodyLayout.Parent = body

    local open = defaultOpen == true
    -- 核心修复：UIScale 会缩放 AbsoluteContentSize，但 Section.Size 是逻辑值，
    -- 如果直接用已缩放的 AbsoluteContentSize 设置 Size，UIScale 会再次缩放导致二次放大/缩小。
    -- 这里除以 Scaler.Scale 还原为未缩放的基础高度，让 UIScale 只渲染缩放一次。
    local function Refresh()
        local scale = Scaler.Scale
        local h = bodyLayout.AbsoluteContentSize.Y / scale
        if open then
            section.Size = UDim2.new(1, 0, 0, 22 + h + 2)
            body.Size = UDim2.new(1, 0, 0, h + 2)
        else
            section.Size = UDim2.new(1, 0, 0, 22)
            body.Size = UDim2.new(1, 0, 0, 0)
        end
    end

    table.insert(SectionRefreshers, Refresh)
    bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(Refresh)

    header.MouseButton1Click:Connect(function()
        open = not open
        header.Text = (open and "  ▼ " or "  ▶ ") .. title
        body.Visible = open
        Refresh()
    end)

    header.MouseEnter:Connect(function() header.BackgroundTransparency = 0.35 end)
    header.MouseLeave:Connect(function() header.BackgroundTransparency = 0.5 end)
    header.MouseButton1Down:Connect(function() header.BackgroundTransparency = 0.25 end)
    header.MouseButton1Up:Connect(function() header.BackgroundTransparency = 0.35 end)

    task.delay(0.05, Refresh)
    return body
end

