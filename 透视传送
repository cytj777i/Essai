            State.XRaySelectAll[category] = true
            xrayCheckMark.Visible = true
            -- 【修复】立即将当前列表中所有有效对象设为 XRay 选中
            for _, e in ipairs(ListEntries[category]) do
                if e.Object and e.Object.Parent then
