local function UpdateXRay()
    -- 清理无效对象（修复：避免 pairs 遍历中删除）
    local deadHL = {}
    for obj, hl in pairs(XRayHighlights) do
        if not obj or not obj.Parent then
            table.insert(deadHL, {obj, hl})
        end
    end
    for _, pair in ipairs(deadHL) do
        pair[2]:Destroy()
        XRayHighlights[pair[1]] = nil
    end
    local valid = {}
    for _, d in ipairs(XRayNameTags) do
        if d.Target and d.Target.Parent then 
            table.insert(valid, d) 
        else 
            d.Billboard:Destroy() 
        end
    end
    XRayNameTags = valid

    for cat, set in pairs(State.XRaySelected) do
        local hlKey = "HL_" .. cat
        local nameKey = "Name_" .. cat
        local hlColor = State["Color_" .. cat]
        local nameColor = State["Color_Name_" .. cat]
        
        for obj, _ in pairs(set) do
            if obj and obj.Parent then
                -- 【修复】同步更新已存在高亮的颜色
                if State[hlKey] and XRayHighlights[obj] then
                    XRayHighlights[obj].FillColor = hlColor
                    XRayHighlights[obj].OutlineColor = hlColor
                end
                if State[hlKey] and not XRayHighlights[obj] then
                    local hl = Instance.new("Highlight")
                    hl.Name = "XRayHL"
                    hl.FillColor = hlColor
                    hl.OutlineColor = hlColor
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0.2
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = obj
                    hl.Parent = obj
                    XRayHighlights[obj] = hl
                end
                if State[nameKey] then
                    local hasName = false
                    for _, d in ipairs(XRayNameTags) do if d.Target == obj then hasName = true break end end
                    if not hasName then
                        local adornee = GetAdornee(obj, cat)
                        if adornee then
                            local bb = Instance.new("BillboardGui")
                            bb.Name = "XRayNameTag"
                            bb.Size = UDim2.new(0, 120, 0, 20)
                            bb.AlwaysOnTop = true
                            bb.LightInfluence = 0
                            bb.MaxDistance = 10000
                            
                            if adornee.Name == "Head" then
                                bb.StudsOffsetWorldSpace = Vector3.new(0, 1, 0)
                            else
                                bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
                            end
                            
                            bb.Adornee = adornee
                            bb.Parent = NameGui
                            
                            local txt = Instance.new("TextLabel")
                            txt.Size = UDim2.new(1, 0, 1, 0)
                            txt.BackgroundTransparency = 1
                            txt.Text = "◉ " .. obj.Name
                            txt.TextColor3 = nameColor
                            txt.TextSize = 9
                            txt.Font = Enum.Font.GothamBold
                            txt.TextStrokeTransparency = 0.3
                            txt.TextStrokeColor3 = Color3.fromRGB(0,0,0)
                            txt.Parent = bb
                            
                            table.insert(XRayNameTags, {Billboard = bb, Target = obj, Cat = cat})
                        end
                    end
                end
            end
        end
    end

    for cat, set in pairs(State.XRaySelected) do
        local hlKey = "HL_" .. cat
        if not State[hlKey] then
            for obj, _ in pairs(set) do
                if XRayHighlights[obj] then
                    XRayHighlights[obj]:Destroy()
                    XRayHighlights[obj] = nil
                end
            end
        end
        local nameKey = "Name_" .. cat
        if not State[nameKey] then
            for i = #XRayNameTags, 1, -1 do
                if XRayNameTags[i].Cat == cat then
                    XRayNameTags[i].Billboard:Destroy()
                    table.remove(XRayNameTags, i)
                end
            end
        end
    end
end


