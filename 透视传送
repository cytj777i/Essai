    if XRayHighlights[obj] then XRayHighlights[obj]:Destroy() XRayHighlights[obj] = nil end
    for i = #XRayNameTags, 1, -1 do
        if XRayNameTags[i].Target == obj then
            XRayNameTags[i].Billboard:Destroy()
            table.remove(XRayNameTags, i)
        end
    end
end

