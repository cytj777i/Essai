            local toClear = {}
            for obj, _ in pairs(State.XRaySelected[category]) do
                table.insert(toClear, obj)
            end
            for _, obj in ipairs(toClear) do
                State.XRaySelected[category][obj] = nil
                ClearXRayObj(obj)
