-- ==================== 轻量清理循环（仅清理已销毁对象，不扫描世界） ====================
RunService.RenderStepped:Connect(function()
    -- 清理失效的 NameTags
    for i = #XRayNameTags, 1, -1 do
        local d = XRayNameTags[i]
        local t = d.Target
        if not t or not t.Parent then
            d.Billboard:Destroy()
            table.remove(XRayNameTags, i)
            continue
        end
        
        -- 更新颜色与名字
        local txt = d.Billboard:FindFirstChildOfClass("TextLabel")
        if txt then
            txt.TextColor3 = State["Color_Name_" .. d.Cat]
            if d.Cat ~= "Player" then
                txt.Text = "◉ " .. t.Name
            end
        end
        
        -- 如果 Adornee 失效（如角色重生导致 Head 被替换），自动重新绑定
        if not d.Billboard.Adornee or not d.Billboard.Adornee.Parent then
            local newAdornee = GetAdornee(t, d.Cat)
            d.Billboard.Adornee = newAdornee
            if newAdornee then
                if newAdornee.Name == "Head" then
                    d.Billboard.StudsOffsetWorldSpace = Vector3.new(0, 1, 0)
                else
                    d.Billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
                end
            end
        end
    end
    
    -- 清理失效的 Highlights
    local deadHL = {}
    for obj, hl in pairs(XRayHighlights) do
        if not obj or not obj.Parent then
            table.insert(deadHL, {obj, hl})
        end
    end
    for _, pair in ipairs(deadHL) do
        pair[2]:Destroy()
        XRayHighlights[pair[1]] = nil
    end
end)

