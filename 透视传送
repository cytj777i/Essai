local function AddGlassStroke(parent, color, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(90, 100, 140)
    s.Transparency = transparency or 0.75
    s.Thickness = 1
    s.Parent = parent
    return s
end

-- ==================== 核心逻辑函数 ====================
local function GetPos(target, cat)
    if cat == "Player" then
        local c = target.Character
        if c and c:FindFirstChild("HumanoidRootPart") then return c.HumanoidRootPart.Position end
    else
        if target:IsA("Model") then
            if target.PrimaryPart then return target.PrimaryPart.Position end
            local p = target:FindFirstChildWhichIsA("BasePart")
            if p then return p.Position end
        elseif target:IsA("BasePart") then
            return target.Position
        elseif target:IsA("Tool") then
            if target.Parent then
                if target.Parent:IsA("Model") then return GetPos(target.Parent, cat) end
                if target.Parent:IsA("BasePart") then return target.Parent.Position end
            end
        end
    end
    return nil
end

-- 新增：获取用于 BillboardGui 绑定的最佳 Part
local function GetAdornee(target, cat)
    if cat == "Player" then
        local char = target.Character
        if char then
            return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
        end
    else
        if target:IsA("Model") then
            return target:FindFirstChild("Head") or target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
        elseif target:IsA("BasePart") then
            return target
        elseif target:IsA("Tool") then
            if target.Parent then
                if target.Parent:IsA("BasePart") then return target.Parent end
                if target.Parent:IsA("Model") then
                    return target.Parent:FindFirstChild("Head") or target.Parent.PrimaryPart or target.Parent:FindFirstChildWhichIsA("BasePart")
                end
            end
        end
    end
    return nil
end

local function ScanWorld()
    local items, npcs, players = {}, {}, {}
    local pChars = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then pChars[p.Character] = true end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not pChars[obj] then
            table.insert(npcs, obj)
        elseif obj:IsA("Tool") then
            table.insert(items, obj)
        elseif obj:IsA("Model") and not obj:FindFirstChildOfClass("Humanoid") and not pChars[obj] then
            if obj:FindFirstChildWhichIsA("BasePart") and obj.Name ~= "Camera" and obj.Name ~= "Terrain" and obj.Name ~= "Sound" then
                table.insert(items, obj)
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then table.insert(players, p) end
    end
    return items, npcs, players
end

