    TeleBtn.BackgroundTransparency = State.IsLooping and 0.25 or 0.4
end)

local function StartLoop()
    if State.IsLooping then return end
    State.IsLooping = true
    TeleText.Text = "停止"
    TeleBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    TeleBtn.BackgroundTransparency = 0.25
    UpdateTeleText()

    State.LoopThread = task.spawn(function()
        while State.IsLooping and TeleBtn.Parent do
            local targets = {}
            for _, e in ipairs(State.LoopQueue) do
               
                if e.Obj and e.Obj.Parent then table.insert(targets, e) end
            end
            if #targets == 0 then task.wait(0.5) continue end

            for _, e in ipairs(targets) do
                if not State.IsLooping then break end
                local pos = GetPos(e.Obj, e.Cat)
                if pos then
                    local char = player.Character
                    if char then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then hrp.CFrame = CFrame.new(pos + Vector3.new(0, 5, 0)) end
                    end
                end
                task.wait(State.LoopInterval)
            end
        end
        State.IsLooping = false
        if TeleBtn.Parent then
            TeleBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            TeleBtn.BackgroundTransparency = 0.4
            TeleText.Text = "传送"
            UpdateTeleText()
        end
    end)
end

local function StopLoop()
    State.IsLooping = false
end

