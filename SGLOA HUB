local function LoadCoordinates()
	local data = ReadFile(FilePath);
	if data then
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(data);
		end);
		if (success and (type(decoded) == "table")) then
			SavedCoordinates = decoded;
			return true;
		end
	end
	return false;
end
