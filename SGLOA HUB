        end
        NightVisionEnabled = false
        Notify("夜视", "夜视已关闭")
    end
end

-- 无限跳功能
local function ToggleInfiniteJump(enabled)
    if enabled then
        InfiniteJumpEnabled = true
        CurrentJumpConnection = UserInputService.JumpRequest:Connect(function()
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid:ChangeState("Jumping")
                end
            end
        end)
        Notify("无限跳", "无限跳已开启")
    else
        InfiniteJumpEnabled = false
        if CurrentJumpConnection then
            CurrentJumpConnection:Disconnect()
            CurrentJumpConnection = nil
        end
        Notify("无限跳", "无限跳已关闭")
    end
end

-- 穿墙模式
local function ToggleNoclip(enabled)
    if enabled then
        NoclipEnabled = true
        CurrentNoclipConnection = RunService.Stepped:Connect(function()
            if not NoclipEnabled then
                CurrentNoclipConnection:Disconnect()
                return
            end
            local character = LocalPlayer.Character
            if character then
                for _, part in pairs(character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
        Notify("穿墙模式", "穿墙模式已开启")
    else
        NoclipEnabled = false
        if CurrentNoclipConnection then
            CurrentNoclipConnection:Disconnect()
            CurrentNoclipConnection = nil
        end
        local character = LocalPlayer.Character
        if character then
            for _, part in pairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
        Notify("穿墙模式", "穿墙模式已关闭")
    end
end

