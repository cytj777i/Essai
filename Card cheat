local function getMyPlacedPacks()
    local packs = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:GetAttribute("Owner") == LocalPlayer.Name then
            table.insert(packs, obj)
        end
    end
    return packs
end

local function getPlacedCount()
    return #getMyPlacedPacks()
end

local function getHeldPacksFromData()
    if not ClientDataManager then return {} end
    local success, data = pcall(function()
        return ClientDataManager.GetData and ClientDataManager.GetData()
    end)
    if not success or not data or not data.HeldPacks then return {} end

    local packs = {}
    for packName, variants in pairs(data.HeldPacks) do
        for variantName, mutations in pairs(variants) do
            for mutationName, info in pairs(mutations) do
                if type(info) == "table" and info.Amount and info.Amount > 0 then
                    table.insert(packs, {
                        id = packName .. "_" .. variantName .. "_" .. mutationName,
                        packName = packName,
                        variantName = variantName,
                        mutationName = mutationName,
                        amount = info.Amount
                    })
                end
            end
        end
    end
    return packs
end

local function selectRandomPack(heldPacks)
    if #heldPacks == 0 then return nil end
    return heldPacks[math.random(#heldPacks)]
end

local function teleportToPosition(targetPos)
    local character = LocalPlayer.Character
    if not character then return false end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    hrp.CFrame = CFrame.new(targetPos.X, targetPos.Y + 3, targetPos.Z)
    return true
end

local function executePlaceAtPosition(posIndex)
    if not equipPackToolEvent or not unequipPackToolEvent then
        return false, "未找到 EquipPackTool 或 UnequipPackTool"
    end

    local placedCount = getPlacedCount()
    if placedCount >= maxPlaceCount then
        return false, "已达上限"
    end

    local pos = placePositions[posIndex]
    if not pos then
        return false, "位置 " .. posIndex .. " 未设置"
    end

    local heldPacks = getHeldPacksFromData()
    local packToPlace = selectRandomPack(heldPacks)
    if not packToPlace then
        return false, "没有持有的卡包"
    end

    -- 传送前通知
    pcall(function()
        WindUI:Notify({
            Title = "自动放置",
            Content = "正在传送到位置 " .. posIndex .. "...",
            Duration = 2,
        })
    end)

    if not teleportToPosition(pos) then
        return false, "传送失败"
    end
    task.wait(0.3)

    pcall(function()
        equipPackToolEvent:FireServer(packToPlace.packName, packToPlace.variantName, packToPlace.mutationName)
    end)
    task.wait(0.4)

    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        local tool = nil
        for _, obj in ipairs(character:GetChildren()) do
            if obj:IsA("Tool") then
                tool = obj
                break
            end
        end
        if tool then
            tool:Activate()
            for _, child in ipairs(tool:GetDescendants()) do
                if child:IsA("RemoteEvent") then
                    pcall(function()
                        child:FireServer(pos)
                    end)
                end
            end
        end
        task.wait(0.5)
        unequipPackToolEvent:FireServer()
    end)

    -- 放置成功通知
    pcall(function()
        WindUI:Notify({
            Title = "自动放置",
            Content = "已在位置 " .. posIndex .. " 放置卡包",
            Duration = 2,
        })
    end)

    return true, "已在位置 " .. posIndex .. " 放置"
end

local function startAutoPlace()
    if autoPlaceEnabled then
        placeLoop = task.spawn(function()
            while autoPlaceEnabled do
                local placedCount = getPlacedCount()
                if placedCount < maxPlaceCount then
                    for i = 1, 10 do
                        if placePositions[i] then
                            local hasPack = false
                            local myPacks = getMyPlacedPacks()
                            for _, pack in ipairs(myPacks) do
                                if pack and pack.Parent and (pack.Position - placePositions[i]).Magnitude < 5 then
                                    hasPack = true
                                    break
                                end
                            end
                            if not hasPack then
                                local success, msg = executePlaceAtPosition(i)
                                if success then
                                end
                                break
                            end
                        end
                    end
                end
                task.wait(placeInterval)
            end
        end)
    end
end

