-- ==================== 放置位置函数（带标记刷新）====================
function setPosition(index)
    local character = LocalPlayer.Character
    if not character then
        pcall(function()
            WindUI:Notify({ Title = "错误", Content = "角色未加载", Duration = 2 })
        end)
        return
    end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        pcall(function()
            WindUI:Notify({ Title = "错误", Content = "未找到 HumanoidRootPart", Duration = 2 })
        end)
        return
    end
    local pos = hrp.Position - Vector3.new(0, 3, 0)
    placePositions[index] = pos
    savePositions()
    refreshMarkersIfVisible()   -- 设置后立即刷新标记
    pcall(function()
        WindUI:Notify({
            Title = "位置 " .. index .. " 已设置",
            Content = string.format("坐标: X=%.1f, Y=%.1f, Z=%.1f", pos.X, pos.Y, pos.Z),
            Duration = 2
        })
    end)
end

function clearPosition(index)
    placePositions[index] = nil
    savePositions()
    refreshMarkersIfVisible()   -- 删除后立即刷新标记
    pcall(function()
        WindUI:Notify({
            Title = "位置 " .. index .. " 已删除",
            Content = "该位置不再用于自动放置",
            Duration = 2
        })
    end)
end

