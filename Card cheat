-- 安全获取远程事件（修复版）
local function getRemoteEvent(name)
    -- 优先直接从 ReplicatedStorage.Remotes 获取，避开 Remoting 模块潜在的无限等待/递归
    local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
    if remotesFolder then
        local directRemote = remotesFolder:FindFirstChild(name)
        if directRemote and directRemote:IsA("RemoteEvent") then 
            return directRemote 
        end
        
        -- 带超时的 WaitForChild，防止无限挂起
        local success, result = pcall(function()
            return remotesFolder:WaitForChild(name, 3)
        end)
        if success and result and result:IsA("RemoteEvent") then
            return result
        end
    end
    
    -- 回退到 Remoting 模块（仅作为备选）
    if Remoting and Remoting.RemoteEvent then
        local success, remote = pcall(function()
            return Remoting.RemoteEvent(name)
        end)
        if success and remote then return remote end
    end
    
    warn("[CardHelper] 未能获取远程事件: " .. tostring(name))
    return nil
end

