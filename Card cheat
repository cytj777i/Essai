    pcall(function()
        oldPromptRobuxPurchase = hookfunction(MarketplaceService.PromptRobuxPurchase, function(self, assetId, ...)
            if blockPurchasePrompts then return nil end
            return oldPromptRobuxPurchase(self, assetId, ...)
        end)
    end)

    local oldPromptBundlePurchase
    pcall(function()
        oldPromptBundlePurchase = hookfunction(MarketplaceService.PromptBundlePurchase, function(self, player, bundleId, ...)
            if blockPurchasePrompts then return nil end
            return oldPromptBundlePurchase(self, player, bundleId, ...)
        end)
    end)

    local oldPromptSubscriptionPurchase
    pcall(function()
        oldPromptSubscriptionPurchase = hookfunction(MarketplaceService.PromptSubscriptionPurchase, function(self, player, subscriptionId, ...)
            if blockPurchasePrompts then return nil end
            return oldPromptSubscriptionPurchase(self, player, subscriptionId, ...)
        end)
    end)

    local function closePurchasePrompts()
        pcall(function()
            for _, gui in ipairs(CoreGui:GetDescendants()) do
                if gui:IsA("ScreenGui") then
                    local name = gui.Name:lower()
                    if name:find("purchase") or name:find("prompt") or name:find("buy") or name:find("shop") or name:find("robux") or name:find("premium") then
                        gui.Enabled = false
