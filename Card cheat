-- ==================== 功能函数 ====================
local function collectAllCards()
    local count = 0
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part:GetAttribute("Card") then
            local cardId = part:GetAttribute("Card")
            if cardId and collectCardEvent then
                collectCardEvent:FireServer(cardId)
                count = count + 1
            end
        end
    end
    return count
end

local function startAutoCollect()
    if autoCollectEnabled then
        collectLoop = task.spawn(function()
            while autoCollectEnabled do
                local collected = collectAllCards()
                if collected > 0 then
                end
                task.wait(collectInterval)
            end
        end)
    end
end

local function stopAutoCollect()
    autoCollectEnabled = false
    if collectLoop then
        task.cancel(collectLoop)
        collectLoop = nil
    end
end

local function collectReadyPacks()
    local collected = 0
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part:GetAttribute("Owner") == LocalPlayer.Name then
            local timerLabel = part:FindFirstChild("TimerLabel", true)
            if timerLabel and timerLabel:IsA("TextLabel") and timerLabel.Text == "Ready" and collectPackEvent then
                if not collectedPacks[part] then
                    collectPackEvent:FireServer(part.Name)
                    collectedPacks[part] = true
                    collected = collected + 1
                end
            end
        end
    end
    return collected
end

local function cleanupCollectedPacks()
    for part, _ in pairs(collectedPacks) do
        if not part or not part.Parent then
            collectedPacks[part] = nil
        else
            local timerLabel = part:FindFirstChild("TimerLabel", true)
            if not timerLabel or not timerLabel:IsA("TextLabel") or timerLabel.Text ~= "Ready" then
                collectedPacks[part] = nil
            end
        end
    end
end

local function startAutoPackCollect()
    if autoPackCollectEnabled then
        packCollectLoop = task.spawn(function()
            while autoPackCollectEnabled do
                cleanupCollectedPacks()
                local collected = collectReadyPacks()
                if collected > 0 then
                end
                task.wait(packCollectInterval)
            end
        end)
    end
end

local function stopAutoPackCollect()
    autoPackCollectEnabled = false
    if packCollectLoop then
        task.cancel(packCollectLoop)
        packCollectLoop = nil
    end
end

