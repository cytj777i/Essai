    end
end

local function createPlaceMarker(index, position)
    local markerModel = Instance.new("Model")
    markerModel.Name = "PlaceMarker_" .. index

    -- 半透明球体
    local sphere = Instance.new("Part")
    sphere.Name = "Visual"
    sphere.Shape = Enum.PartType.Ball
    sphere.Size = Vector3.new(1.5, 1.5, 1.5)
    sphere.Anchored = true
    sphere.CanCollide = false
    sphere.Transparency = 0.35
    sphere.Color = Color3.fromRGB(70, 130, 180)
    sphere.Material = Enum.Material.Neon
    sphere.Position = position
    sphere.Parent = markerModel

    -- 光晕
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(70, 130, 180)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.Adornee = sphere
    highlight.Parent = sphere

    -- BillboardGui 固定像素大小（关键修复：SizeOffset 阻止距离缩放，增大尺寸和字号）
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Label"
    billboard.Size = UDim2.new(0, 100, 0, 22)      -- 加大尺寸，确保文字完整显示
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 1.8, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 10000                  -- 极远距离仍可显示
    billboard.SizeOffset = Vector2.new(0, 0)       -- 核心属性：彻底固定像素，不受距离影响
    billboard.Adornee = sphere
    billboard.Parent = sphere

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = "位置 " .. index
    textLabel.TextColor3 = Color3.new(1, 1, 1)        -- 白色基底，供渐变使用
    textLabel.TextStrokeTransparency = 0.3
    textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextScaled = false                      -- 关闭自动缩放，保持固定像素
    textLabel.TextSize = 16                           -- 增大字号，清晰可见
    textLabel.Parent = billboard

    -- ========== 银蓝色渐变字体 (UIGradient) ==========
    local uiGradient = Instance.new("UIGradient")
    uiGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, Color3.fromRGB(210, 220, 235)),  -- 银白
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(130, 160, 200)), -- 浅钢蓝
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(70, 130, 180)),   -- 钢蓝
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(130, 160, 200)), -- 过渡回浅色
        ColorSequenceKeypoint.new(1.0, Color3.fromRGB(210, 220, 235))   -- 银白
    })
    uiGradient.Rotation = 90   -- 垂直渐变
    uiGradient.Parent = textLabel

    markerModel.Parent = workspace
    return markerModel
end

